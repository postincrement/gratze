
NFD_BUILD_TYPE=@NFD_BUILD_TYPE@
NFD_BUILD_ENV=@NFD_BUILD_ENV@
NFD_BUILD_DIR=@NFD_BUILD_DIR@
NFD_LIB_DIR=@NFD_LIB_DIR@
NFD_LIB=$(NFD_LIB_DIR)/@NFD_LIB_NAME@

CC=@CC@
CXX=@CXX@
CXXFLAGS=@CXXFLAGS@
CFLAGS=@CFLAGS@

LDFLAGS += @LDFLAGS@ 
LDLIBS = @LDLIBS@  
LINK.o = $(LINK.cc)

APP = gratze

all:	$(APP)

################################################################################################	

SRCS_CC = main.cc \
	  			magmedia/fdc.cc \
					magmedia/cassette.cc \
					video/sdl_video.cc \
					emulators/emulator.cc \
					trs80/trs80.cc \
					trs80/model1/model1.cc \
					trs80/model3/model3.cc \
					trs80/model4/model4.cc \

SRCS_C  = emulators/mfz80/Z80.c \
          trs80/model1/rom_level2.c

vpath %.cc $(sort $(dir $(SRCS_CC)))
vpath %.c  $(sort $(dir $(SRCS_C)))

INC_DIRS = -I. $(addprefix -I./,$(sort $(dir $(SRCS_C) $(SRCS_CC))))

CXXFLAGS := $(CXXFLAGS) $(INC_DIRS)
CCFLAGS := $(CCFLAGS) $(INC_DIRS)

OBJS	= $(SRCS_CC:.cc=.o) $(SRCS_C:.c=.o)

gratze:	$(OBJS)

gratze:	nfd sdl $(OBJS)
	$(CXX) $(LDFLAGS) -o $@ $(OBJS) $(LDLIBS)


################################################################################################	

main.o:	main.cc 

Z80.o: emulators/mfz80/Z80.c

debug.o: emulators/mfz80/debug.c

sdl_video.o: video/sdl_video.cc

emulator.o: emulators/emulator.cc 

trs80.o: trs80/trs80.cc 

fdc.o: magmedia/fdc.cc 

cassette.o: magmedia/cassette.cc

################################################################################################	

MING_SDL=@MING_SDL@

ifeq ($(MING_SDL),1)

SDL_DIR=SDL2-2.0.10/i686-w64-mingw32

LDFLAGS:=$(LDFLAGS) -L$(SDL_DIR)/lib
CXXFLAGS:=$(CXXFLAGS) -I$(SDL_DIR)/include
LDLIBS:= $(LDLIBS)
sdl:

else

sdl:

endif

################################################################################################	

$(NFD_LIB): nfd

clean_nfd:
	cd nativefiledialog/build/$(NFD_BUILD_DIR) && $(NFD_BUILD_ENV) sh -c "make config=$(NFD_BUILD_TYPE) clean"

nfd: 
	if test \! -d nativefiledialog ; then \
		git clone https://github.com/postincrement/nativefiledialog.git \
	  cd nativefiledialog/build/$(NFD_BUILD_DIR) && \
		$(NFD_BUILD_ENV) sh -c "make config=$(NFD_BUILD_TYPE) clean && make config=$(NFD_BUILD_TYPE) nfd" ; \
	else \
	  cd nativefiledialog/build/$(NFD_BUILD_DIR) && \
		$(NFD_BUILD_ENV) sh -c "make config=$(NFD_BUILD_TYPE) nfd" ; \
	fi

################################################################################################	

clean: clean_nfd
	rm -f $(APP) $(OBJS)

