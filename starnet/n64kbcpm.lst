# File n64kbcpm.asm
0000			; n64kbcpm — 64kbcpm with private BIOS stack while video bank $14 is mapped. 
0000			; Build: z80asm n64kbcpm.asm -o n64kbcpm.slv 
0000			; 
0000			; Same CCP/BDOS as 64kbcpm. BIOS keeps the $D600 jump table; DPB moves to 
0000			; $DE00 (server m_dpbOffset 0x1e00). Bank helpers switch SP to $DCD4 for 
0000			; the bank-$14 window so callers with SP near $9000 are not smashed by VDU. 
0000			 
0000				org 0c000h 
c000			 
c000			; BN ROM helpers used by BIOS 
c000			rom_conout:	equ 0xe00c 
c000			rom_net_io:	equ 0xe042 
c000			; BDOS still contains a word table misparsed as CALL Z,sub_dbd4h (CC D4 DB). 
c000			; Keep the absolute so those bytes round-trip until that table is DEFW'd. 
c000			sub_dbd4h:	equ 0dbd4h 
c000			 
c000				include '64kbcpm_ccp.inc' 
