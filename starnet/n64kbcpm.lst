d706			; Former DPB table — private-stack + bank-$14 helpers (DPB moved to $DE00). 
d706			; Must occupy exactly $D706-$D75F (90 bytes) so D760 stays put. 
d706			dpb_table_old: 
d706			 
d706			; BLOCK 'bios_stack_stub' (start 0xd706 end 0xd760) 
d706				org 0d706h 
d706			bios_stack_stub_start: 
d706			bank_video_low_x: 
d706 cd 2d d7			call stack_enter 
d709 3e 14			ld a,014h 
d70b f3				di 
d70c d3 50			out (050h),a 
d70e 32 47 dc			ld (ldc47h),a 
d711 fb				ei 
d712 c9				ret 
d713			bank_video_off_x: 
d713 f5				push af 
d714 3e 0c			ld a,00ch 
d716 18 03			jr bank_set_leave 
d718			bank_normal_x: 
d718 f5				push af 
d719 3e 04			ld a,004h 
d71b			bank_set_leave: 
d71b f3				di 
d71c d3 50			out (050h),a 
d71e 32 47 dc			ld (ldc47h),a 
d721 fb				ei 
d722 f1				pop af 
d723 18 1e			jr stack_leave 
d725			ld92_restore: 
d725 f3				di 
d726 d3 50			out (050h),a 
d728 32 47 dc			ld (ldc47h),a 
d72b 18 16			jr stack_leave 
d72d			; Switch to private stack for the whole bank-$14 window. 
d72d			; saved_sp is the caller's SP from *before* CALL bank_video_low (after we 
d72d			; have lifted both the stub return and the caller's return off the old 
d72d			; stack). Leave restores that SP so a later RET in the caller is correct. 
d72d			stack_enter: 
d72d 3a ac dc			ld a,(stack_flag) 
d730 b7				or a 
d731 c0				ret nz 
d732 d1				pop de			; return into bank_video_low_x 
d733 f3				di 
d734 e1				pop hl			; return to bank_video_low's caller 
d735 ed 73 ad dc		ld (saved_sp),sp	; SP as it was before CALL bank_video_low 
d739 31 d4 dc			ld sp,stack_top 
d73c e5				push hl 
d73d d5				push de 
d73e 3c				inc a 
d73f 32 ac dc			ld (stack_flag),a 
d742 c9				ret 
d743			; Leave private stack. Always reached via CALL bank_off/normal (disk 
d743			; READ/WRITE uses `call bank_normal; ret` rather than a tail JP so the 
d743			; private stack always holds a continuation). AF/flags survive for 
d743			; callers that test Z after `call bank_normal`. 
d743			stack_leave: 
d743 f5				push af 
d744 3a ac dc			ld a,(stack_flag) 
d747 b7				or a 
d748 28 0c			jr z,stack_leave_done 
d74a af				xor a 
d74b 32 ac dc			ld (stack_flag),a 
d74e f1				pop af 
d74f e1				pop hl			; return after CALL bank_off/normal 
d750 ed 7b ad dc		ld sp,(saved_sp) 
d754 fb				ei 
d755 e9				jp (hl) 
d756			stack_leave_done: 
d756 f1				pop af 
d757 c9				ret 
d758			; Save prior bank latch in BSS then enter bank $14 (conout path). The 
d758			; old `push af` lived on the caller stack and was stranded by stack_enter. 
d758			bank_video_save: 
d758 32 af dc			ld (saved_bank),a 
d75b 18 a9			jr bank_video_low_x 
d75d 00...			defs 0xd760 - $ 
d760			 
d760			; BLOCK 'bios_spare0' (start 0xd760 end 0xd78d) 
d760			; First 11 bytes: warm-boot trampoline — BN $E024 loads the $D642 
d760			; 80-col CRTC table (HL = one past end), then continues to $E039 with A=2. 
d760			bios_spare0_start: 
d760			warm_crtc_e039: 
d760 21 51 d6			ld hl,ld651h		;d760 
d763 cd 24 e0			call 0e024h		;d763 
d766 3e 02			ld a,002h		;d766 
d768 c3 39 e0			jp 0e039h		;d768 
