

LINK.o = $(LINK.cc)
OBJDIR = ./obj
DEPDIR = ./.deps

LIB = libgrzdisk.a

DEPFLAGS = -MT $@ -MMD -MP -MF $(DEPDIR)/$*.d

MINGW_ENABLED=@MINGW_ENABLED@

ifeq ($(MINGW_ENABLED),1)

MING_ARCH=@MING_ARCH@

endif # MINGW_ENABLED

INC_DIRS = -I$(shell pwd)

CC=@CC@
CXX=@CXX@

CXXFLAGS := @CXXFLAGS@ $(INC_DIRS) -I..
CFLAGS   := @CFLAGS@   $(INC_DIRS)

LDFLAGS=@LDFLAGS@ -g
LDLIBS=@LDLIBS@

COMPILE.c  = $(CC) $(DEPFLAGS) $(CFLAGS) $(CPPFLAGS) $(TARGET_ARCH) -c
COMPILE.cc = $(CXX) $(DEPFLAGS) $(CXXFLAGS) $(CPPFLAGS) $(TARGET_ARCH) -c

OUTPUT_OPTION = -o $(OBJDIR)/$*.o

ifeq ($(VERBOSE),1)

%.o : %.c 
$(OBJDIR)/%.o : %.c | $(DEPDIR) $(OBJDIR)
	$(COMPILE.c) $(OUTPUT_OPTION) $<
				
%.o : %.cc
$(OBJDIR)/%.o : %.cc | $(DEPDIR) $(OBJDIR)
	$(COMPILE.cc) $(OUTPUT_OPTION) $<

else

$(OBJDIR)/%.o : %.c | $(DEPDIR) $(OBJDIR)
	@echo "(CC) $<"
	@$(COMPILE.c) $(OUTPUT_OPTION) $<
				
%.o : %.cc
$(OBJDIR)/%.o : %.cc | $(DEPDIR) $(OBJDIR)
	@echo "(CXX) $<"
	@$(COMPILE.cc) $(OUTPUT_OPTION) $<

endif

all:	$(LIB)

################################################################################################	

SRCS_CC = \
	../disk/jv1.cc \
	../disk/jv3.cc \
	../disk/dmk.cc \
	../disk/virtual_drive.cc \

SRCS_C =

FILENAMES := $(notdir $(basename $(SRCS_C) $(SRCS_CC)))
OBJS	  := $(addsuffix .o,$(addprefix $(OBJDIR)/,$(FILENAMES)))
DEPFILES  := $(addsuffix .d,$(addprefix $(DEPDIR)/,$(FILENAMES)))

vpath %.c  $(sort $(dir $(SRCS_C)))
vpath %.cc $(sort $(dir $(SRCS_CC)))

test:
	echo $(OBJS)

$(LIB):	$(OBJS)
	$(AR) rcs $(LIB) $(OBJS)

gratze:	nfd sdl ttf cereal $(OBJS)
	$(CXX) $(LDFLAGS) -o $@ $(OBJS) $(LDLIBS)

$(OBJDIR):
	@mkdir -p $@

$(DEPFILES): $(DEPDIR)

$(DEPDIR):
	@mkdir -p $@

include $(wildcard $(DEPFILES))

################################################################################################	

.PHONY : clean

clean: 
	rm -f $(LIB) $(OBJS) $(DEPFILES)

